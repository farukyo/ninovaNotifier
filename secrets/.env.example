# Zorunlu: BotFather'dan alınan bot token'ı
TELEGRAM_TOKEN=your_telegram_bot_token_here

# Admin kullanıcı ID'si; birden fazla admin için virgülle ayır (ör. 111,222)
ADMIN_TELEGRAM_ID=your_admin_telegram_id_here

# İsteğe bağlı: Ninova şifreleri için Fernet anahtarı. Boş bırakılırsa
# secrets/.encryption_key otomatik oluşturulur. Kaybolursa kayıtlı şifreler çözülemez!
# Oluşturmak için: uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# ENCRYPTION_KEY=
